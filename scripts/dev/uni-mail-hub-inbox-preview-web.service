[Unit]
Description=Uni Mail Hub inbox design development server
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=zitu
Group=zitu
WorkingDirectory=/opt/uni-mail-hub/apps/web
EnvironmentFile=/opt/uni-mail-hub/.env.inbox-preview
ExecStart=/usr/bin/node /opt/uni-mail-hub/apps/web/node_modules/next/dist/bin/next dev --hostname 0.0.0.0 --port 4395
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
