# Copy to .env. Replace all example secrets before production use.
NODE_ENV=development
DATABASE_URL=postgresql://unimail:unimail_local@127.0.0.1:15432/unimailhub?schema=public
REDIS_URL=redis://127.0.0.1:16379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key-before-credentials-exist
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
WEB_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000
MAILPIT_HOST=localhost
MAILPIT_PORT=51025
API_PORT=4000
MONITORING_INTERVAL_MINUTES=10
MONITOR_SYNC_WARNING_MINUTES=15
MONITOR_SYNC_CRITICAL_MINUTES=60
MONITOR_QUOTA_WARNING_PERCENT=80
MONITOR_QUOTA_CRITICAL_PERCENT=95
MONITOR_QUOTA_MAX_AGE_HOURS=24
MONITOR_WORKER_HEARTBEAT_SECONDS=90
MONITOR_QUEUE_BACKLOG_WARNING=100
MONITOR_TLS_WARNING_DAYS=30
MAIL_API_RATE_LIMIT_MAX=60
MAIL_API_RATE_LIMIT_WINDOW_SECONDS=60
MAIL_SEND_MAX_ATTEMPTS=4
MAIL_SEND_BACKOFF_BASE_MS=60000
MAIL_SEND_WORKER_CONCURRENCY=5
MAIL_MAX_RECIPIENTS=50
MAIL_MAX_BODY_BYTES=1048576
MAIL_SYNC_INITIAL_DAYS=30
MAIL_SYNC_INITIAL_MAX_MESSAGES=1000
MAIL_SYNC_MAX_MESSAGE_BYTES=26214400
MAIL_SYNC_WORKER_CONCURRENCY=3
MAIL_SYNC_INTERVAL_MINUTES=5
MAIL_SYNC_BATCH_SIZE=250
MAIL_SYNC_FLAG_REFRESH_LIMIT=500
MAIL_ATTACHMENT_MAX_BYTES=10485760
