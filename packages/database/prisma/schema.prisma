generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}

enum DomainStatus {
  UNVERIFIED
  ACTIVE
  ISSUE
  DISABLED
}

enum MailboxStatus {
  UNKNOWN
  HEALTHY
  WARNING
  ERROR
  DISABLED
}

enum MailServerStatus {
  ACTIVE
  DISABLED
}

enum ProviderType {
  CPANEL
  GENERIC
  CUSTOM
  OTHER
}

enum ConnectionSecurity {
  NONE
  STARTTLS
  TLS
}

enum SmtpAuthMode {
  PASSWORD
  NONE
}

enum MailProtocol {
  IMAP
  SMTP
}

enum ConnectionCheckStatus {
  SUCCESS
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(MEMBER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  auditLogs    AuditLog[]
  createdApiKeys ApiKey[] @relation("ApiKeyCreator")
  composedMessages OutgoingMessage[] @relation("WebmailComposeCreator")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  domains     Domain[]
  mailboxes   Mailbox[]
  apiKeys     ApiKey[]
  outgoingMessages OutgoingMessage[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents WebhookEvent[]
  suppressions Suppression[]
  bounces MailBounce[]
}

model Domain {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  domain    String       @unique
  status    DomainStatus @default(UNVERIFIED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  mailboxes Mailbox[]
  cpanelDiscoveries CpanelDiscoveredDomain[]
  dkimSelectors String[] @default([])

  @@index([projectId])
}

model MailServer {
  id           String           @id @default(cuid())
  name         String
  providerType ProviderType     @default(GENERIC)
  imapHost     String?
  imapPort     Int?
  smtpHost     String?
  smtpPort     Int?
  imapSecurity ConnectionSecurity @default(TLS)
  smtpSecurity ConnectionSecurity @default(TLS)
  smtpAuthMode SmtpAuthMode @default(PASSWORD)
  status       MailServerStatus @default(ACTIVE)
  lastTestAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  mailboxes    Mailbox[]
}

model Mailbox {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  domainId        String
  domain          Domain        @relation(fields: [domainId], references: [id], onDelete: Restrict)
  mailServerId    String?
  mailServer      MailServer?   @relation(fields: [mailServerId], references: [id], onDelete: Restrict)
  email           String        @unique
  displayName     String?
  status          MailboxStatus @default(UNKNOWN)
  isActive        Boolean       @default(true)
  lastImapCheckAt DateTime?
  lastSmtpCheckAt DateTime?
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  connectionConfigVersion Int @default(1)
  credential MailboxCredential?
  connectionChecks MailboxConnectionCheck[]
  apiKeyGrants ApiKeyMailboxGrant[]
  outgoingMessages OutgoingMessage[]
  smtpAttempts SmtpAttempt[]
  folders MailFolder[]
  syncedMessages MailMessage[]
  syncRuns MailSyncRun[]
  cpanelDiscoveries CpanelDiscoveredMailbox[]

  @@index([projectId])
  @@index([domainId])
}

enum CpanelAccountStatus {
  ACTIVE
  DISABLED
}

enum CpanelConnectionStatus {
  UNTESTED
  CONNECTED
  AUTH_FAILED
  TLS_FAILED
  TIMEOUT
  CONNECTION_FAILED
}

enum CpanelDiscoveryState {
  DISCOVERED
  MANAGED
  IGNORED
  MISSING
}

enum CpanelDiscoveryRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model CpanelAccount {
  id String @id @default(cuid())
  name String
  host String
  port Int @default(2083)
  username String
  encryptedApiToken String
  encryptionIv String
  encryptionAuthTag String
  encryptionVersion Int @default(1)
  status CpanelAccountStatus @default(ACTIVE)
  connectionStatus CpanelConnectionStatus @default(UNTESTED)
  lastConnectedAt DateTime?
  lastDiscoveryAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domains CpanelDiscoveredDomain[]
  mailboxes CpanelDiscoveredMailbox[]
  forwarders CpanelDiscoveredForwarder[]
  runs CpanelDiscoveryRun[]
}

model CpanelDiscoveredDomain {
  id String @id @default(cuid())
  accountId String
  account CpanelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  domain String
  state CpanelDiscoveryState @default(DISCOVERED)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  managedDomainId String?
  managedDomain Domain? @relation(fields: [managedDomainId], references: [id], onDelete: SetNull)
  @@unique([accountId, domain])
  @@index([state])
}

model CpanelDiscoveredMailbox {
  id String @id @default(cuid())
  accountId String
  account CpanelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email String
  domain String
  state CpanelDiscoveryState @default(DISCOVERED)
  managedMailboxId String?
  managedMailbox Mailbox? @relation(fields: [managedMailboxId], references: [id], onDelete: SetNull)
  usedBytes BigInt?
  quotaBytes BigInt?
  unlimitedQuota Boolean @default(false)
  suspended Boolean?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@unique([accountId, email])
  @@index([state])
  @@index([managedMailboxId])
}

model CpanelDiscoveredForwarder {
  id String @id @default(cuid())
  accountId String
  account CpanelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  domain String
  source String
  destination String
  lastSeenAt DateTime @default(now())
  @@unique([accountId, domain, source, destination], map: "CpanelDiscoveredForwarder_accountId_domain_source_destination_k")
}

model CpanelDiscoveryRun {
  id String @id @default(cuid())
  accountId String
  account CpanelAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status CpanelDiscoveryRunStatus @default(QUEUED)
  startedAt DateTime?
  completedAt DateTime?
  domainsFound Int @default(0)
  mailboxesFound Int @default(0)
  forwardersFound Int @default(0)
  newItems Int @default(0)
  missingItems Int @default(0)
  errorCode String?
  errorMessage String?
  requestedByUserId String?
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

enum MailFolderSpecialUse {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
  OTHER
}

enum MailContentStatus {
  COMPLETE
  SKIPPED_TOO_LARGE
  PARSE_FAILED
}

enum MailSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum MailRecipientType {
  TO
  CC
  BCC
  REPLY_TO
}

model MailFolder {
  id               String               @id @default(cuid())
  mailboxId        String
  mailbox          Mailbox              @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  path             String
  name             String
  delimiter        String?
  specialUse       MailFolderSpecialUse @default(OTHER)
  isSelectable     Boolean              @default(true)
  uidValidity      String?
  uidNext          BigInt?
  highestSyncedUid BigInt               @default(0)
  messageCount     Int?
  unseenCount      Int?
  lastSyncedAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  messages         MailMessage[]

  @@unique([mailboxId, path])
  @@index([mailboxId, specialUse])
}

model MailMessage {
  id              String            @id @default(cuid())
  mailboxId       String
  mailbox         Mailbox           @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folderId        String
  folder          MailFolder        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  imapUid         BigInt
  messageIdHeader String?
  threadKey       String?
  subject         String?
  date            DateTime?
  internalDate    DateTime?
  fromName        String?
  fromEmail       String?
  textBody        String?           @db.Text
  htmlBody        String?           @db.Text
  sizeBytes       BigInt?
  contentStatus   MailContentStatus @default(COMPLETE)
  isSeen          Boolean           @default(false)
  isFlagged       Boolean           @default(false)
  isAnswered      Boolean           @default(false)
  isDraft         Boolean           @default(false)
  isDeleted       Boolean           @default(false)
  inReplyTo       String?
  references      String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recipients      MailRecipient[]
  attachments     MailAttachment[]
  bounce MailBounce?

  @@unique([folderId, imapUid])
  @@index([mailboxId, internalDate])
  @@index([mailboxId, messageIdHeader], map: "MailMessage_mailbox_header_idx")
  @@index([folderId, threadKey, internalDate, id], map: "MailMessage_folder_thread_date_idx")
}

model MailRecipient {
  id        String            @id @default(cuid())
  messageId String
  message   MailMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MailRecipientType
  name      String?
  email     String

  @@index([messageId, type])
}

model MailAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String?
  contentType String
  sizeBytes   BigInt?
  contentId   String?
  disposition String?
  imapPart    String?

  @@index([messageId])
}

model MailSyncRun {
  id               String         @id @default(cuid())
  mailboxId        String
  mailbox          Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  status           MailSyncStatus @default(RUNNING)
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  foldersProcessed Int            @default(0)
  messagesAdded    Int            @default(0)
  messagesUpdated  Int            @default(0)
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime       @default(now())

  @@index([mailboxId, startedAt])
  @@index([status, startedAt])
}

model MailboxCredential {
  id String @id @default(cuid())
  mailboxId String @unique
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  username String
  encryptedPassword String
  encryptionIv String
  encryptionAuthTag String
  encryptionVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastRotatedAt DateTime @default(now())
}

model MailboxConnectionCheck {
  id String @id @default(cuid())
  mailboxId String
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  protocol MailProtocol
  status ConnectionCheckStatus
  latencyMs Int
  errorCode String?
  errorMessage String?
  configVersion Int
  testedAt DateTime @default(now())
  testedByUserId String?

  @@index([mailboxId, protocol, testedAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name       String
  keyPrefix  String
  keyHash    String
  scopes     String[] @default(["MAIL_SEND"])
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt DateTime?
  createdByUserId String?
  createdBy User? @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  grants ApiKeyMailboxGrant[]
  outgoingMessages OutgoingMessage[]

  @@index([projectId])
  @@unique([keyHash])
}

model ApiKeyMailboxGrant {
  id String @id @default(cuid())
  apiKeyId String
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  canSend Boolean @default(true)
  createdAt DateTime @default(now())

  @@unique([apiKeyId, mailboxId])
  @@index([mailboxId])
}

enum OutgoingStatus {
  QUEUED
  PROCESSING
  RETRY_SCHEDULED
  SMTP_ACCEPTED
  SMTP_ACCEPTED_WITH_REJECTIONS
  FAILED
  CANCELLED
}

enum RecipientType {
  TO
  CC
  BCC
}

enum RecipientSmtpStatus {
  PENDING
  ACCEPTED
  REJECTED
  BOUNCED
}

enum SmtpAttemptStatus {
  ACCEPTED
  PARTIAL
  FAILED
}

enum OutboxStatus {
  READY
  PUBLISHED
}

model OutgoingMessage {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  apiKeyId String?
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  createdByUserId String?
  createdBy User? @relation("WebmailComposeCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fromMailboxId String
  fromMailbox Mailbox @relation(fields: [fromMailboxId], references: [id], onDelete: Restrict)
  subject String
  textBody String?
  htmlBody String?
  replyToEmail String?
  replyToName String?
  inReplyTo String?
  references String[] @default([])
  status OutgoingStatus @default(QUEUED)
  priority Int @default(0)
  idempotencyKey String
  requestHash String
  attemptCount Int @default(0)
  queuedAt DateTime @default(now())
  processingAt DateTime?
  smtpAcceptedAt DateTime?
  failedAt DateTime?
  lastErrorCode String?
  lastErrorMessage String?
  rfcMessageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients OutgoingRecipient[]
  attempts SmtpAttempt[]
  outboxEvents OutboxEvent[]
  bounces MailBounce[]

  @@unique([apiKeyId, idempotencyKey])
  @@unique([createdByUserId, idempotencyKey], map: "OutgoingMessage_admin_idempotency_key")
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model OutgoingRecipient {
  id String @id @default(cuid())
  messageId String
  message OutgoingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type RecipientType
  email String
  name String?
  smtpStatus RecipientSmtpStatus @default(PENDING)
  smtpResponse String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId, type])
}

model SmtpAttempt {
  id String @id @default(cuid())
  messageId String
  message OutgoingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  attemptNumber Int
  status SmtpAttemptStatus
  startedAt DateTime
  finishedAt DateTime @default(now())
  latencyMs Int
  smtpResponseCode Int?
  smtpResponse String?
  messageIdHeader String?
  errorCode String?
  errorMessage String?
  createdAt DateTime @default(now())

  @@unique([messageId, attemptNumber])
}

model OutboxEvent {
  id String @id @default(cuid())
  messageId String
  message OutgoingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status OutboxStatus @default(READY)
  availableAt DateTime @default(now())
  publishedAt DateTime?
  createdAt DateTime @default(now())

  @@index([status, availableAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

enum MonitoringStatus {
  HEALTHY
  WARNING
  CRITICAL
  UNKNOWN
}

enum MonitoringRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum MonitoringIssueStatus {
  OPEN
  RESOLVED
}

model MonitoringRun {
  id String @id @default(cuid())
  trigger String
  status MonitoringRunStatus @default(QUEUED)
  startedAt DateTime?
  completedAt DateTime?
  resultCount Int @default(0)
  issueCount Int @default(0)
  errorCode String?
  requestedByUserId String?
  createdAt DateTime @default(now())
  results MonitoringResult[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model MonitoringResult {
  id String @id @default(cuid())
  runId String
  run MonitoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  targetType String
  targetId String
  targetName String
  checkType String
  status MonitoringStatus
  summary String
  details Json?
  checkedAt DateTime @default(now())
  latencyMs Int?
  errorCode String?

  @@unique([runId, targetType, targetId, checkType])
  @@index([targetType, targetId, checkedAt])
  @@index([status, checkedAt])
}

model MonitoringIssue {
  id String @id @default(cuid())
  targetType String
  targetId String
  targetName String
  checkType String
  status MonitoringIssueStatus @default(OPEN)
  severity MonitoringStatus
  summary String
  errorCode String?
  firstDetectedAt DateTime @default(now())
  lastDetectedAt DateTime @default(now())
  resolvedAt DateTime?
  lastHealthyAt DateTime?

  @@index([status, severity, lastDetectedAt])
  @@index([targetType, targetId, checkType, status])
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  RETRY_SCHEDULED
  FAILED
}

enum BounceClassification {
  HARD_BOUNCE
  SOFT_BOUNCE
  UNKNOWN
}

enum SuppressionReason {
  HARD_BOUNCE
  MANUAL
}

model WebhookEndpoint {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name String
  url String
  encryptedSecret String
  encryptionIv String
  encryptionAuthTag String
  encryptionVersion Int @default(1)
  status WebhookEndpointStatus @default(ACTIVE)
  subscriptions String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastDeliveryAt DateTime?
  deliveries WebhookDelivery[]

  @@index([projectId, status])
}

model WebhookEvent {
  id String @id
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  eventKey String @unique
  type String
  resourceType String
  resourceId String
  payload Json
  createdAt DateTime @default(now())
  deliveries WebhookDelivery[]

  @@index([projectId, createdAt])
}

model WebhookDelivery {
  id String @id @default(cuid())
  eventId String
  event WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  endpointId String
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  replayOfId String?
  status WebhookDeliveryStatus @default(PENDING)
  attemptCount Int @default(0)
  httpStatus Int?
  responseSnippet String?
  durationMs Int?
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  lastAttemptAt DateTime?
  deliveredAt DateTime?
  errorCode String?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([eventId])
}

model MailBounce {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceMessageId String @unique
  sourceMessage MailMessage @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  outgoingMessageId String?
  outgoingMessage OutgoingMessage? @relation(fields: [outgoingMessageId], references: [id], onDelete: SetNull)
  recipientEmail String?
  originalMessageId String?
  action String?
  statusCode String?
  classification BounceClassification
  correlationCode String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([outgoingMessageId])
}

model Suppression {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  email String
  reason SuppressionReason
  source String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastFailureAt DateTime?

  @@unique([projectId, email])
  @@index([projectId, createdAt])
}
