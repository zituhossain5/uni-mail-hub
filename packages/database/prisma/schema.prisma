generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}

enum DomainStatus {
  UNVERIFIED
  ACTIVE
  ISSUE
  DISABLED
}

enum MailboxStatus {
  UNKNOWN
  HEALTHY
  WARNING
  ERROR
  DISABLED
}

enum MailServerStatus {
  ACTIVE
  DISABLED
}

enum ProviderType {
  CPANEL
  GENERIC
  CUSTOM
  OTHER
}

enum ConnectionSecurity {
  NONE
  STARTTLS
  TLS
}

enum SmtpAuthMode {
  PASSWORD
  NONE
}

enum MailProtocol {
  IMAP
  SMTP
}

enum ConnectionCheckStatus {
  SUCCESS
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(MEMBER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  auditLogs    AuditLog[]
  createdApiKeys ApiKey[] @relation("ApiKeyCreator")
  composedMessages OutgoingMessage[] @relation("WebmailComposeCreator")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  domains     Domain[]
  mailboxes   Mailbox[]
  apiKeys     ApiKey[]
  outgoingMessages OutgoingMessage[]
}

model Domain {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  domain    String       @unique
  status    DomainStatus @default(UNVERIFIED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  mailboxes Mailbox[]

  @@index([projectId])
}

model MailServer {
  id           String           @id @default(cuid())
  name         String
  providerType ProviderType     @default(GENERIC)
  imapHost     String?
  imapPort     Int?
  smtpHost     String?
  smtpPort     Int?
  imapSecurity ConnectionSecurity @default(TLS)
  smtpSecurity ConnectionSecurity @default(TLS)
  smtpAuthMode SmtpAuthMode @default(PASSWORD)
  status       MailServerStatus @default(ACTIVE)
  lastTestAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  mailboxes    Mailbox[]
}

model Mailbox {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  domainId        String
  domain          Domain        @relation(fields: [domainId], references: [id], onDelete: Restrict)
  mailServerId    String?
  mailServer      MailServer?   @relation(fields: [mailServerId], references: [id], onDelete: Restrict)
  email           String        @unique
  displayName     String?
  status          MailboxStatus @default(UNKNOWN)
  isActive        Boolean       @default(true)
  lastImapCheckAt DateTime?
  lastSmtpCheckAt DateTime?
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  connectionConfigVersion Int @default(1)
  credential MailboxCredential?
  connectionChecks MailboxConnectionCheck[]
  apiKeyGrants ApiKeyMailboxGrant[]
  outgoingMessages OutgoingMessage[]
  smtpAttempts SmtpAttempt[]
  folders MailFolder[]
  syncedMessages MailMessage[]
  syncRuns MailSyncRun[]

  @@index([projectId])
  @@index([domainId])
}

enum MailFolderSpecialUse {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
  OTHER
}

enum MailContentStatus {
  COMPLETE
  SKIPPED_TOO_LARGE
  PARSE_FAILED
}

enum MailSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum MailRecipientType {
  TO
  CC
  BCC
  REPLY_TO
}

model MailFolder {
  id               String               @id @default(cuid())
  mailboxId        String
  mailbox          Mailbox              @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  path             String
  name             String
  delimiter        String?
  specialUse       MailFolderSpecialUse @default(OTHER)
  isSelectable     Boolean              @default(true)
  uidValidity      String?
  uidNext          BigInt?
  highestSyncedUid BigInt               @default(0)
  messageCount     Int?
  unseenCount      Int?
  lastSyncedAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  messages         MailMessage[]

  @@unique([mailboxId, path])
  @@index([mailboxId, specialUse])
}

model MailMessage {
  id              String            @id @default(cuid())
  mailboxId       String
  mailbox         Mailbox           @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folderId        String
  folder          MailFolder        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  imapUid         BigInt
  messageIdHeader String?
  threadKey       String?
  subject         String?
  date            DateTime?
  internalDate    DateTime?
  fromName        String?
  fromEmail       String?
  textBody        String?           @db.Text
  htmlBody        String?           @db.Text
  sizeBytes       BigInt?
  contentStatus   MailContentStatus @default(COMPLETE)
  isSeen          Boolean           @default(false)
  isFlagged       Boolean           @default(false)
  isAnswered      Boolean           @default(false)
  isDraft         Boolean           @default(false)
  isDeleted       Boolean           @default(false)
  inReplyTo       String?
  references      String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recipients      MailRecipient[]
  attachments     MailAttachment[]

  @@unique([folderId, imapUid])
  @@index([mailboxId, internalDate])
  @@index([mailboxId, messageIdHeader], map: "MailMessage_mailbox_header_idx")
  @@index([folderId, threadKey, internalDate, id], map: "MailMessage_folder_thread_date_idx")
}

model MailRecipient {
  id        String            @id @default(cuid())
  messageId String
  message   MailMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MailRecipientType
  name      String?
  email     String

  @@index([messageId, type])
}

model MailAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String?
  contentType String
  sizeBytes   BigInt?
  contentId   String?
  disposition String?
  imapPart    String?

  @@index([messageId])
}

model MailSyncRun {
  id               String         @id @default(cuid())
  mailboxId        String
  mailbox          Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  status           MailSyncStatus @default(RUNNING)
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  foldersProcessed Int            @default(0)
  messagesAdded    Int            @default(0)
  messagesUpdated  Int            @default(0)
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime       @default(now())

  @@index([mailboxId, startedAt])
  @@index([status, startedAt])
}

model MailboxCredential {
  id String @id @default(cuid())
  mailboxId String @unique
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  username String
  encryptedPassword String
  encryptionIv String
  encryptionAuthTag String
  encryptionVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastRotatedAt DateTime @default(now())
}

model MailboxConnectionCheck {
  id String @id @default(cuid())
  mailboxId String
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  protocol MailProtocol
  status ConnectionCheckStatus
  latencyMs Int
  errorCode String?
  errorMessage String?
  configVersion Int
  testedAt DateTime @default(now())
  testedByUserId String?

  @@index([mailboxId, protocol, testedAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name       String
  keyPrefix  String
  keyHash    String
  scopes     String[] @default(["MAIL_SEND"])
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt DateTime?
  createdByUserId String?
  createdBy User? @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  grants ApiKeyMailboxGrant[]
  outgoingMessages OutgoingMessage[]

  @@index([projectId])
  @@unique([keyHash])
}

model ApiKeyMailboxGrant {
  id String @id @default(cuid())
  apiKeyId String
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  canSend Boolean @default(true)
  createdAt DateTime @default(now())

  @@unique([apiKeyId, mailboxId])
  @@index([mailboxId])
}

enum OutgoingStatus {
  QUEUED
  PROCESSING
  RETRY_SCHEDULED
  SMTP_ACCEPTED
  SMTP_ACCEPTED_WITH_REJECTIONS
  FAILED
  CANCELLED
}

enum RecipientType {
  TO
  CC
  BCC
}

enum RecipientSmtpStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SmtpAttemptStatus {
  ACCEPTED
  PARTIAL
  FAILED
}

enum OutboxStatus {
  READY
  PUBLISHED
}

model OutgoingMessage {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  apiKeyId String?
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  createdByUserId String?
  createdBy User? @relation("WebmailComposeCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fromMailboxId String
  fromMailbox Mailbox @relation(fields: [fromMailboxId], references: [id], onDelete: Restrict)
  subject String
  textBody String?
  htmlBody String?
  replyToEmail String?
  replyToName String?
  inReplyTo String?
  references String[] @default([])
  status OutgoingStatus @default(QUEUED)
  priority Int @default(0)
  idempotencyKey String
  requestHash String
  attemptCount Int @default(0)
  queuedAt DateTime @default(now())
  processingAt DateTime?
  smtpAcceptedAt DateTime?
  failedAt DateTime?
  lastErrorCode String?
  lastErrorMessage String?
  rfcMessageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients OutgoingRecipient[]
  attempts SmtpAttempt[]
  outboxEvents OutboxEvent[]

  @@unique([apiKeyId, idempotencyKey])
  @@unique([createdByUserId, idempotencyKey], map: "OutgoingMessage_admin_idempotency_key")
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model OutgoingRecipient {
  id String @id @default(cuid())
  messageId String
  message OutgoingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type RecipientType
  email String
  name String?
  smtpStatus RecipientSmtpStatus @default(PENDING)
  smtpResponse String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId, type])
}

model SmtpAttempt {
  id String @id @default(cuid())
  messageId String
  message OutgoingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  attemptNumber Int
  status SmtpAttemptStatus
  startedAt DateTime
  finishedAt DateTime @default(now())
  latencyMs Int
  smtpResponseCode Int?
  smtpResponse String?
  messageIdHeader String?
  errorCode String?
  errorMessage String?
  createdAt DateTime @default(now())

  @@unique([messageId, attemptNumber])
}

model OutboxEvent {
  id String @id @default(cuid())
  messageId String
  message OutgoingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status OutboxStatus @default(READY)
  availableAt DateTime @default(now())
  publishedAt DateTime?
  createdAt DateTime @default(now())

  @@index([status, availableAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
