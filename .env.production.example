# Copy to .env.production and set chmod 600. Never commit the populated file.
NODE_ENV=production
APP_VERSION=replace-with-immutable-release-or-git-sha
WEB_URL=https://mail.example.com
UNI_MAIL_HUB_PUBLIC_URL=https://mail.example.com
ALLOWED_ORIGINS=https://mail.example.com
API_URL=http://uni-mail-hub-api:4000
API_PORT=4000
API_BIND_HOST=0.0.0.0
DATABASE_URL=postgresql://unimail:REPLACE_URL_ENCODED_PASSWORD@uni-mail-hub-postgres:5432/unimailhub?schema=public
REDIS_URL=redis://uni-mail-hub-redis:6379
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
MAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
POSTGRES_USER=unimail
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
POSTGRES_DB=unimailhub
TLS_CERT_DIR=/etc/uni-mail-hub/tls
EXTERNAL_TLS_TERMINATION=false
BACKUP_HOST_DIR=/var/backups/uni-mail-hub
BACKUP_DIR=/backups
BACKUP_PG_MODE=native
BACKUP_RETENTION_DAYS=30
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
RETENTION_ENABLED=false
MAIL_SEND_WORKER_CONCURRENCY=5
MAIL_SYNC_WORKER_CONCURRENCY=3
MONITORING_INTERVAL_MINUTES=10
SEED_ADMIN_NAME=REPLACE_WITH_ADMIN_NAME
SEED_ADMIN_EMAIL=replace-with-admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
